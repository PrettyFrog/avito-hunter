[Unit]
Description=Avito Hunter public polling and delivery service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
User=avito-hunter
Group=avito-hunter
WorkingDirectory=/opt/avito-hunter
Environment=PYTHONUNBUFFERED=1
Environment=HUNTER_DATA_DIR=/var/lib/avito-hunter
EnvironmentFile=/etc/avito-hunter/avito-hunter.env
ExecStart=/opt/avito-hunter/.venv/bin/hunter run
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group
UMask=0077
StateDirectory=avito-hunter
StateDirectoryMode=0750
LogsDirectory=avito-hunter
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryHigh=1100M
MemoryMax=1400M
TasksMax=256

[Install]
WantedBy=multi-user.target
