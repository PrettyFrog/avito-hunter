# Telegram (preferred). Create a bot via @BotFather, then write yourself once so it can DM you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional fallback push: https://ntfy.sh/your-topic or a self-hosted ntfy
NTFY_URL=

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# GigaChat (Round 2). Not required for collection / Round 1.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Local OpenAI-compatible endpoint (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_VLM_MODEL=qwen2.5vl:3b

# OpenRouter :free fallback (50 req/day)
OPENROUTER_API_KEY=

# Public V2 Polling Cadence
HUNTER_PUBLIC_V2__ENABLED=false
HUNTER_PUBLIC_V2__DAY_INTERVAL_SEC=10.0
HUNTER_PUBLIC_V2__NIGHT_INTERVAL_SEC=30.0
HUNTER_PUBLIC_V2__JITTER_RATIO=0.25
HUNTER_PUBLIC_V2__MAX_JITTER_SEC=180.0

